# ---------- 依赖 ----------
node_modules/

# ---------- 服务端敏感配置（含密钥，绝不入库）----------
# 首次启动会自动按 DEFAULTS 生成占位文件，部署时在服务器上填真实值即可
data/api.json
data/geo.json

# 其它可能的密钥文件
.env
.env.*
*.pem
*.key

# ---------- 日志 / 运行时 ----------
*.log
logs/
npm-debug.log*
pm2-*.log

# ---------- 操作系统 / 编辑器 ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# ---------- 工具产生的数据目录 ----------
# 如希望随仓库同步，删除下面这行即可
.codebuddy/
